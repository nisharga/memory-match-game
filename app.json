{
  "expo": {
    "name": "Memory Match",
    "slug": "memory-match",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "memorymatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nisharga.memorymatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nisharga.memorymatch",
      "adaptiveIcon": {
        "backgroundColor": "#EEF2FF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softInputMode": "adjustResize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter/Inter-Regular.ttf",
            "./assets/fonts/Inter/Inter-Medium.ttf",
            "./assets/fonts/Inter/Inter-SemiBold.ttf",
            "./assets/fonts/Inter/Inter-Bold.ttf"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "bruskee",
          "project": "cute-cat"
        }
      ],
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "529bdd2b-d368-4a4f-80e2-424dbd561a16"
      }
    },
    "owner": "nisharga.sharetasking",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/529bdd2b-d368-4a4f-80e2-424dbd561a16"
    }
  }
}
